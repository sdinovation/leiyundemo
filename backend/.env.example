# ===== LLM 配置 =====
# DeepSeek (推荐 - 国内访问稳定 + 价格低)
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# OpenAI (备选)
# LLM_API_KEY=sk-your-openai-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ===== Embedding 模型（FAISS 语义缓存用）=====
# 首次启动会自动从 HuggingFace 下载 ~120MB
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# ===== FAISS 语义缓存 =====
FAISS_SIMILARITY_THRESHOLD=0.92
FAISS_MAX_ENTRIES=10000

# ===== 应用 =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# ===== 文件上传 =====
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=csv,xlsx,xls

# ===== CORS =====
# 前端默认从 file:// 协议打开，也支持 localhost 开发服务器
CORS_ORIGINS=*